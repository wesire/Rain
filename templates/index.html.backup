<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rain Video Creator - Interactive Timeline</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 50%, #1e3c72 100%);
            min-height: 100vh;
            padding: 20px;
            color: #fff;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        }

        header {
            text-align: center;
            margin-bottom: 40px;
        }

        h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
            background: linear-gradient(45deg, #4facfe, #00f2fe);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .subtitle {
            color: #b0c4de;
            font-size: 1.1em;
        }

        .settings-panel {
            background: rgba(255, 255, 255, 0.08);
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 30px;
        }

        .settings-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 20px;
        }

        .setting-item {
            display: flex;
            flex-direction: column;
        }

        label {
            font-weight: 600;
            margin-bottom: 8px;
            color: #e0e0e0;
            font-size: 0.95em;
        }

        input[type="number"],
        input[type="text"] {
            padding: 12px;
            border: 2px solid rgba(255, 255, 255, 0.2);
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.1);
            color: #fff;
            font-size: 1em;
            transition: all 0.3s;
        }

        input[type="number"]:focus,
        input[type="text"]:focus {
            outline: none;
            border-color: #4facfe;
            background: rgba(255, 255, 255, 0.15);
        }

        .timeline-section {
            background: rgba(255, 255, 255, 0.08);
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 30px;
        }

        .section-title {
            font-size: 1.5em;
            margin-bottom: 20px;
            color: #4facfe;
        }

        .timeline-canvas-wrapper {
            background: rgba(0, 0, 0, 0.3);
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 20px;
            position: relative;
        }

        #timelineCanvas {
            width: 100%;
            height: 300px;
            border-radius: 8px;
            cursor: crosshair;
            background: linear-gradient(to bottom, rgba(255,255,255,0.02), rgba(255,255,255,0.05));
        }

        .timeline-controls {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-top: 20px;
        }

        .slider-control {
            display: flex;
            flex-direction: column;
        }

        .slider-label {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
        }

        .slider-value {
            color: #4facfe;
            font-weight: bold;
        }

        input[type="range"] {
            width: 100%;
            height: 8px;
            border-radius: 5px;
            background: rgba(255, 255, 255, 0.2);
            outline: none;
            -webkit-appearance: none;
        }

        input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: linear-gradient(135deg, #4facfe, #00f2fe);
            cursor: pointer;
            box-shadow: 0 2px 8px rgba(79, 172, 254, 0.5);
        }

        input[type="range"]::-moz-range-thumb {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: linear-gradient(135deg, #4facfe, #00f2fe);
            cursor: pointer;
            border: none;
            box-shadow: 0 2px 8px rgba(79, 172, 254, 0.5);
        }

        .button-group {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }

        button {
            padding: 15px 30px;
            border: none;
            border-radius: 10px;
            font-size: 1em;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            flex: 1;
            min-width: 150px;
        }

        .btn-primary {
            background: linear-gradient(135deg, #4facfe, #00f2fe);
            color: #fff;
            box-shadow: 0 4px 15px rgba(79, 172, 254, 0.4);
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(79, 172, 254, 0.6);
        }

        .btn-secondary {
            background: rgba(255, 255, 255, 0.2);
            color: #fff;
        }

        .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.3);
        }

        .btn-danger {
            background: linear-gradient(135deg, #f093fb, #f5576c);
            color: #fff;
        }

        .btn-danger:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(245, 87, 108, 0.4);
        }

        button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none !important;
        }

        .progress-section {
            background: rgba(255, 255, 255, 0.08);
            border-radius: 15px;
            padding: 25px;
            margin-top: 30px;
            display: none;
        }

        .progress-section.active {
            display: block;
        }

        .progress-bar-wrapper {
            background: rgba(0, 0, 0, 0.3);
            border-radius: 10px;
            height: 30px;
            overflow: hidden;
            margin-bottom: 15px;
        }

        .progress-bar {
            height: 100%;
            background: linear-gradient(90deg, #4facfe, #00f2fe);
            width: 0%;
            transition: width 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-weight: bold;
        }

        .progress-message {
            text-align: center;
            color: #b0c4de;
            font-size: 1.1em;
        }

        .info-box {
            background: rgba(79, 172, 254, 0.1);
            border-left: 4px solid #4facfe;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 20px;
        }

        .info-box h3 {
            margin-bottom: 10px;
            color: #4facfe;
        }

        .info-box ul {
            list-style: none;
            padding-left: 0;
        }

        .info-box li {
            padding: 5px 0;
            color: #b0c4de;
        }

        .info-box li:before {
            content: "▸ ";
            color: #4facfe;
        }

        .timeline-legend {
            display: flex;
            gap: 20px;
            margin-top: 15px;
            flex-wrap: wrap;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .legend-color {
            width: 20px;
            height: 20px;
            border-radius: 4px;
        }

        @media (max-width: 768px) {
            .container {
                padding: 20px;
            }

            h1 {
                font-size: 2em;
            }

            .settings-grid {
                grid-template-columns: 1fr;
            }

            .timeline-controls {
                grid-template-columns: 1fr;
            }

            .button-group {
                flex-direction: column;
            }

            button {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>🌧️ Rain Video Creator</h1>
            <p class="subtitle">Create beautiful rain videos with dynamic intensity variations</p>
        </header>

        <div class="settings-panel">
            <h2 class="section-title">Video Settings</h2>
            <div class="settings-grid">
                <div class="setting-item">
                    <label for="duration">Duration (hours)</label>
                    <input type="number" id="duration" value="0.1" min="0.01" max="24" step="0.1">
                </div>
                <div class="setting-item">
                    <label for="outputName">Output Filename</label>
                    <input type="text" id="outputName" value="rain_video.mp4">
                </div>
            </div>
            
            <div class="info-box">
                <h3>Quick Tips</h3>
                <ul>
                    <li>Start with 0.1 hours (6 minutes) for quick testing</li>
                    <li>Click on the timeline to add intensity control points</li>
                    <li>Drag control points to adjust intensity and timing</li>
                    <li>Use sliders to modify the selected point's properties</li>
                </ul>
            </div>
        </div>

        <div class="timeline-section">
            <h2 class="section-title">Intensity Timeline Editor</h2>
            
            <div class="timeline-canvas-wrapper">
                <canvas id="timelineCanvas"></canvas>
            </div>

            <div class="timeline-controls">
                <div class="slider-control">
                    <div class="slider-label">
                        <label>Rain Intensity</label>
                        <span class="slider-value" id="intensityValue">50%</span>
                    </div>
                    <input type="range" id="intensitySlider" min="0" max="100" value="50">
                </div>

                <div class="slider-control">
                    <div class="slider-label">
                        <label>Drop Density</label>
                        <span class="slider-value" id="densityValue">50%</span>
                    </div>
                    <input type="range" id="densitySlider" min="0" max="100" value="50">
                </div>
            </div>

            <div class="timeline-legend">
                <div class="legend-item">
                    <div class="legend-color" style="background: linear-gradient(135deg, #4facfe, #00f2fe);"></div>
                    <span>Intensity Curve</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color" style="background: #f5576c;"></div>
                    <span>Control Points</span>
                </div>
            </div>
        </div>

        <div class="button-group">
            <button class="btn-primary" id="generateBtn">Generate Video</button>
            <button class="btn-secondary" id="clearBtn">Clear Timeline</button>
            <button class="btn-secondary" id="presetLightBtn">Preset: Light Rain</button>
            <button class="btn-secondary" id="presetStormBtn">Preset: Storm</button>
        </div>

        <div class="progress-section" id="progressSection">
            <h2 class="section-title">Generation Progress</h2>
            <div class="progress-bar-wrapper">
                <div class="progress-bar" id="progressBar">0%</div>
            </div>
            <p class="progress-message" id="progressMessage">Initializing...</p>
            <div class="button-group">
                <button class="btn-danger" id="cancelBtn">Cancel Generation</button>
            </div>
        </div>
    </div>

    <script>
        // Timeline state
        let timelinePoints = [];
        let selectedPoint = null;
        let canvasWidth, canvasHeight;
        let isDragging = false;

        // Canvas setup
        const canvas = document.getElementById('timelineCanvas');
        const ctx = canvas.getContext('2d');

        function setupCanvas() {
            const rect = canvas.getBoundingClientRect();
            canvas.width = rect.width * window.devicePixelRatio;
            canvas.height = rect.height * window.devicePixelRatio;
            ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
            canvasWidth = rect.width;
            canvasHeight = rect.height;
        }

        function drawTimeline() {
            // Clear canvas
            ctx.clearRect(0, 0, canvasWidth, canvasHeight);

            const duration = parseFloat(document.getElementById('duration').value) * 3600; // seconds

            // Draw grid
            ctx.strokeStyle = 'rgba(255, 255, 255, 0.1)';
            ctx.lineWidth = 1;
            
            // Vertical grid lines (time markers)
            const timeSteps = 5;
            for (let i = 0; i <= timeSteps; i++) {
                const x = (i / timeSteps) * canvasWidth;
                ctx.beginPath();
                ctx.moveTo(x, 0);
                ctx.lineTo(x, canvasHeight);
                ctx.stroke();
                
                // Time labels
                const time = (i / timeSteps) * duration;
                const minutes = Math.floor(time / 60);
                const seconds = Math.floor(time % 60);
                ctx.fillStyle = 'rgba(255, 255, 255, 0.5)';
                ctx.font = '12px sans-serif';
                ctx.fillText(`${minutes}:${seconds.toString().padStart(2, '0')}`, x + 5, canvasHeight - 5);
            }

            // Horizontal grid lines (intensity markers)
            const intensitySteps = 4;
            for (let i = 0; i <= intensitySteps; i++) {
                const y = (i / intensitySteps) * canvasHeight;
                ctx.beginPath();
                ctx.moveTo(0, y);
                ctx.lineTo(canvasWidth, y);
                ctx.stroke();
                
                // Intensity labels
                const intensity = 100 - (i / intensitySteps) * 100;
                ctx.fillStyle = 'rgba(255, 255, 255, 0.5)';
                ctx.fillText(`${intensity.toFixed(0)}%`, 5, y - 5);
            }

            // Sort points by time
            timelinePoints.sort((a, b) => a.time - b.time);

            // Draw intensity curve
            if (timelinePoints.length > 0) {
                ctx.strokeStyle = '#4facfe';
                ctx.lineWidth = 3;
                ctx.beginPath();

                // Start from first point
                const firstX = (timelinePoints[0].time / duration) * canvasWidth;
                const firstY = (1 - timelinePoints[0].intensity) * canvasHeight;
                ctx.moveTo(0, firstY);
                ctx.lineTo(firstX, firstY);

                // Draw lines between points
                for (let i = 0; i < timelinePoints.length; i++) {
                    const point = timelinePoints[i];
                    const x = (point.time / duration) * canvasWidth;
                    const y = (1 - point.intensity) * canvasHeight;
                    ctx.lineTo(x, y);
                }

                // Extend to end
                const lastPoint = timelinePoints[timelinePoints.length - 1];
                const lastY = (1 - lastPoint.intensity) * canvasHeight;
                ctx.lineTo(canvasWidth, lastY);
                ctx.stroke();

                // Draw gradient fill under curve
                const gradient = ctx.createLinearGradient(0, 0, 0, canvasHeight);
                gradient.addColorStop(0, 'rgba(79, 172, 254, 0.3)');
                gradient.addColorStop(1, 'rgba(79, 172, 254, 0.05)');
                ctx.fillStyle = gradient;
                ctx.lineTo(canvasWidth, canvasHeight);
                ctx.lineTo(0, canvasHeight);
                ctx.closePath();
                ctx.fill();

                // Draw control points
                timelinePoints.forEach((point, index) => {
                    const x = (point.time / duration) * canvasWidth;
                    const y = (1 - point.intensity) * canvasHeight;

                    // Point circle
                    ctx.fillStyle = point === selectedPoint ? '#f5576c' : '#4facfe';
                    ctx.beginPath();
                    ctx.arc(x, y, 8, 0, Math.PI * 2);
                    ctx.fill();

                    // White border
                    ctx.strokeStyle = '#fff';
                    ctx.lineWidth = 2;
                    ctx.stroke();
                });
            }
        }

        function getPointAtPosition(x, y) {
            const duration = parseFloat(document.getElementById('duration').value) * 3600;
            
            for (let point of timelinePoints) {
                const px = (point.time / duration) * canvasWidth;
                const py = (1 - point.intensity) * canvasHeight;
                const distance = Math.sqrt((x - px) ** 2 + (y - py) ** 2);
                
                if (distance < 15) {
                    return point;
                }
            }
            return null;
        }

        // Canvas event handlers
        canvas.addEventListener('click', (e) => {
            const rect = canvas.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;

            const clickedPoint = getPointAtPosition(x, y);
            
            if (clickedPoint) {
                selectedPoint = clickedPoint;
                updateSliders();
            } else {
                // Add new point
                const duration = parseFloat(document.getElementById('duration').value) * 3600;
                const time = (x / canvasWidth) * duration;
                const intensity = 1 - (y / canvasHeight);
                
                const newPoint = {
                    time: time,
                    intensity: intensity,
                    drop_density: 0.5
                };
                
                timelinePoints.push(newPoint);
                selectedPoint = newPoint;
                updateSliders();
            }
            
            drawTimeline();
        });

        canvas.addEventListener('mousedown', (e) => {
            const rect = canvas.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            
            const clickedPoint = getPointAtPosition(x, y);
            if (clickedPoint) {
                isDragging = true;
                selectedPoint = clickedPoint;
                updateSliders();
            }
        });

        canvas.addEventListener('mousemove', (e) => {
            if (isDragging && selectedPoint) {
                const rect = canvas.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                
                const duration = parseFloat(document.getElementById('duration').value) * 3600;
                selectedPoint.time = Math.max(0, Math.min(duration, (x / canvasWidth) * duration));
                selectedPoint.intensity = Math.max(0, Math.min(1, 1 - (y / canvasHeight)));
                
                updateSliders();
                drawTimeline();
            }
        });

        canvas.addEventListener('mouseup', () => {
            isDragging = false;
        });

        canvas.addEventListener('dblclick', (e) => {
            const rect = canvas.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            
            const clickedPoint = getPointAtPosition(x, y);
            if (clickedPoint) {
                // Remove point on double-click
                timelinePoints = timelinePoints.filter(p => p !== clickedPoint);
                selectedPoint = null;
                updateSliders();
                drawTimeline();
            }
        });

        // Slider handlers
        document.getElementById('intensitySlider').addEventListener('input', (e) => {
            const value = e.target.value / 100;
            document.getElementById('intensityValue').textContent = `${e.target.value}%`;
            
            if (selectedPoint) {
                selectedPoint.intensity = value;
                drawTimeline();
            }
        });

        document.getElementById('densitySlider').addEventListener('input', (e) => {
            const value = e.target.value / 100;
            document.getElementById('densityValue').textContent = `${e.target.value}%`;
            
            if (selectedPoint) {
                selectedPoint.drop_density = value;
            }
        });

        function updateSliders() {
            if (selectedPoint) {
                document.getElementById('intensitySlider').value = selectedPoint.intensity * 100;
                document.getElementById('intensityValue').textContent = `${Math.round(selectedPoint.intensity * 100)}%`;
                
                document.getElementById('densitySlider').value = (selectedPoint.drop_density || 0.5) * 100;
                document.getElementById('densityValue').textContent = `${Math.round((selectedPoint.drop_density || 0.5) * 100)}%`;
            }
        }

        // Button handlers
        document.getElementById('generateBtn').addEventListener('click', async () => {
            const duration = parseFloat(document.getElementById('duration').value);
            const outputName = document.getElementById('outputName').value;
            
            // Ensure at least 2 points for timeline
            if (timelinePoints.length < 2) {
                alert('Please add at least 2 control points to the timeline');
                return;
            }

            // Show progress section
            document.getElementById('progressSection').classList.add('active');
            document.getElementById('generateBtn').disabled = true;

            try {
                const response = await fetch('/api/generate', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        duration: duration,
                        timeline: timelinePoints,
                        output: outputName
                    })
                });

                if (response.ok) {
                    // Start polling for status
                    pollStatus();
                } else {
                    alert('Failed to start generation');
                    document.getElementById('generateBtn').disabled = false;
                }
            } catch (error) {
                alert('Error: ' + error.message);
                document.getElementById('generateBtn').disabled = false;
            }
        });

        document.getElementById('clearBtn').addEventListener('click', () => {
            if (confirm('Clear all timeline points?')) {
                timelinePoints = [];
                selectedPoint = null;
                drawTimeline();
            }
        });

        document.getElementById('presetLightBtn').addEventListener('click', () => {
            const duration = parseFloat(document.getElementById('duration').value) * 3600;
            timelinePoints = [
                { time: 0, intensity: 0.2, drop_density: 0.3 },
                { time: duration, intensity: 0.3, drop_density: 0.4 }
            ];
            selectedPoint = null;
            drawTimeline();
        });

        document.getElementById('presetStormBtn').addEventListener('click', () => {
            const duration = parseFloat(document.getElementById('duration').value) * 3600;
            timelinePoints = [
                { time: 0, intensity: 0.3, drop_density: 0.5 },
                { time: duration * 0.25, intensity: 0.7, drop_density: 0.8 },
                { time: duration * 0.5, intensity: 0.9, drop_density: 1.0 },
                { time: duration * 0.75, intensity: 0.6, drop_density: 0.7 },
                { time: duration, intensity: 0.4, drop_density: 0.5 }
            ];
            selectedPoint = null;
            drawTimeline();
        });

        document.getElementById('cancelBtn').addEventListener('click', async () => {
            await fetch('/api/cancel', { method: 'POST' });
        });

        // Status polling
        let statusInterval;
        function pollStatus() {
            statusInterval = setInterval(async () => {
                try {
                    const response = await fetch('/api/status');
                    const status = await response.json();

                    document.getElementById('progressBar').style.width = status.progress + '%';
                    document.getElementById('progressBar').textContent = status.progress + '%';
                    document.getElementById('progressMessage').textContent = status.message;

                    if (!status.in_progress) {
                        clearInterval(statusInterval);
                        document.getElementById('generateBtn').disabled = false;

                        if (status.output_file && !status.error) {
                            document.getElementById('progressMessage').innerHTML = 
                                `✓ ${status.message}<br><a href="/download/${status.output_file}" style="color: #4facfe;">Download Video</a>`;
                        } else if (status.error) {
                            document.getElementById('progressMessage').textContent = 'Error: ' + status.error;
                        }
                    }
                } catch (error) {
                    console.error('Error polling status:', error);
                }
            }, 1000);
        }

        // Initialize
        window.addEventListener('resize', () => {
            setupCanvas();
            drawTimeline();
        });

        // Add default points on load
        window.addEventListener('load', () => {
            setupCanvas();
            
            // Add default points for demonstration
            const duration = parseFloat(document.getElementById('duration').value) * 3600;
            timelinePoints = [
                { time: 0, intensity: 0.5, drop_density: 0.5 },
                { time: duration, intensity: 0.5, drop_density: 0.5 }
            ];
            
            drawTimeline();
        });
    </script>
</body>
</html>
